{
  "name": "mtg-mullagain-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "vite build",
    "generate:api": "nswag run nswag.json",
    "generate:schema": "ts-node scripts/generate-pglite-schema.ts",
    "generate:all": "npm run generate:api && npm run generate:schema",
    "dev": "npm run generate:all && vite dev",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^2.1.1",
    "@sveltejs/adapter-static": "^2.0.3",
    "@sveltejs/kit": "^1.20.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.8",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.8.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-svelte": "^2.30.0",
    "jsdom": "^27.0.0",
    "nswag": "^14.6.1",
    "pg": "^8.16.3",
    "postcss": "^8.4.31",
    "prettier": "^3.0.3",
    "prettier-plugin-svelte": "^3.0.3",
    "svelte": "^4.0.5",
    "svelte-check": "^3.4.3",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "^3.3.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^4.4.2",
    "vitest": "^3.2.4"
  },
  "type": "module",
  "dependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@microsoft/signalr": "^8.0.0",
    "@scryfall/api-types": "^1.0.0-alpha.4",
    "@tanstack/svelte-query": "^5.0.0",
    "localforage": "^1.10.0",
    "mana-font": "^1.18.0",
    "recharts": "^2.8.0",
    "scryfall-api": "^4.0.4",
    "uuid": "^13.0.0"
  }
}
